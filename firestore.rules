rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function ownsPost() {
      return signedIn() && request.auth.uid == resource.data.authorId;
    }

    function canReadPost(postId) {
      let post = get(/databases/$(database)/documents/posts/$(postId));
      return post.data.visibility != 'private' || (signedIn() && post.data.authorId == request.auth.uid);
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if ownsUser(userId)
        && request.resource.data.uid == userId;
      allow update: if ownsUser(userId)
        && request.resource.data.uid == resource.data.uid;
      allow delete: if ownsUser(userId);
    }

    match /posts/{postId} {
      allow read: if resource.data.visibility != 'private' || ownsPost();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.visibility in ['public', 'followers', 'private'];
      allow update: if ownsPost()
        && request.resource.data.authorId == resource.data.authorId;
      allow delete: if ownsPost();

      match /likes/{likeId} {
        allow read: if canReadPost(postId);
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && likeId == request.auth.uid;
        allow update: if false;
        allow delete: if signedIn()
          && resource.data.userId == request.auth.uid;
      }

      match /comments/{commentId} {
        allow read: if canReadPost(postId);
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid;
        allow update: if signedIn()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.postId == resource.data.postId;
        allow delete: if signedIn()
          && resource.data.authorId == request.auth.uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
